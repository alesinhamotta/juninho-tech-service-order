# ============================================================
# JUNINHO.TECH - Variáveis de Ambiente
# ============================================================
# Copie este arquivo e renomeie para .env
# NUNCA envie o arquivo .env para o GitHub!
# ============================================================

# Porta do servidor (padrão: 3001)
PORT=3001

# URL de conexão com o banco de dados Neon Postgres
# Copie a Connection String do painel do Neon (console.neon.tech)
DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@SEU_HOST.neon.tech/neondb?sslmode=require

# Chave secreta para geração de tokens JWT
# Use uma senha longa e aleatória
JWT_SECRET=juninho-tech-2024-coloque-uma-senha-segura-aqui

# Ambiente (development ou production)
NODE_ENV=development

# Origens permitidas para o CORS (separadas por vírgula)
# Em produção, coloque a URL do seu frontend na Vercel
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================================
# WhatsApp Business Platform (Cloud API oficial da Meta)
# Mantenha essas variáveis apenas no servidor. Nunca exponha tokens no site.
# ============================================================
# Token permanente ou de longa duração criado no Meta Business Manager.
WHATSAPP_ACCESS_TOKEN=
# ID do número remetente conectado à API do WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=
# Versão da Graph API selecionada no painel da Meta, por exemplo: vXX.X
WHATSAPP_GRAPH_API_VERSION=
# Nome do modelo de utilidade aprovado pela Meta com 3 variáveis no corpo:
# Olá, {{1}}! Atualização da sua OS {{2}}: {{3}}
WHATSAPP_TEMPLATE_STATUS_NAME=
WHATSAPP_TEMPLATE_STATUS_LANGUAGE=pt_BR
# Segredo do aplicativo Meta e token aleatório escolhido por você para validar o webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
